# APP & ENVIRONMENT
NODE_ENV=development
PORT=4000
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# DATABASE & REDIS
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/whatsapp_ai_db?schema=public"
REDIS_URL="redis://localhost:6379"

# AUTHENTICATION
JWT_SECRET=super_secret_jwt_key_change_in_production_2026_whatsapp_ai
JWT_EXPIRES_IN=7d

# PROVIDER FLAGS
AI_PROVIDER=mock       # mock | openai
MESSAGING_PROVIDER=simulator # simulator | whatsapp
BILLING_PROVIDER=fake  # fake | stripe

# OPENAI (Used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-mock-key-for-development

# META WHATSAPP CLOUD API (Used when MESSAGING_PROVIDER=whatsapp)
META_WEBHOOK_VERIFY_TOKEN=wh_verify_secret_123
META_GRAPH_API_VERSION=v19.0

# STORAGE
STORAGE_TYPE=local
STORAGE_PATH=./uploads
